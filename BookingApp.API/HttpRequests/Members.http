@BaseUrl = {{Host}}/members
@MemberId = 51f7b919-872d-406e-9ad1-e0b03c02296d

### Get all Members
GET {{BaseUrl}}
Accept: application/json
Authorization: Bearer {{Token}}

### Get Member by Id
GET {{BaseUrl}}/{{MemberId}}
Accept: application/json
Authorization: Bearer {{Token}}

### Post new Member
POST {{BaseUrl}}
Content-Type: application/json
Authorization: Bearer {{Token}}

{
  "firstName": "Dean",
  "lastName": "Winchester",
  "role": "Customer",
  "email": "d.winchester@gmail.com",
  "phoneNumber": "+11234567890"
}

### Update Member
PUT {{BaseUrl}}/{{MemberId}}
Content-Type: application/json
Authorization: Bearer {{Token}}

{
  "firstName": "Dean",
  "lastName": "Winchester",
  "email": "d.winchester@gmail.com",
  "phoneNumber": "+11234567890"
}

### Delete Member
DELETE {{BaseUrl}}/{{MemberId}}
Authorization: Bearer {{Token}}
