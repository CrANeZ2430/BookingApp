@BaseUrl = {{Host}}/bookings
@BookingId = 409b4c5f-556c-44a8-867c-45aabf0ca83f
@MemberId = b1c3072e-4b1c-4a9b-816b-4ca961c87cf0
@RoomId = 1d69be82-aaeb-4497-9af7-1558f0efec0e

### Get Bookings by Member Id
GET {{Host}}/members/{{MemberId}}/bookings
Accept: application/json
Authorization: Bearer {{Token}}

### Get Booking by Id
GET {{BaseUrl}}/{{BookingId}}
Accept: application/json
Authorization: Bearer {{Token}}

### Post new Booking
POST {{BaseUrl}}
Content-Type: application/json
Authorization: Bearer {{Token}}

{
  "attendeeCount": 56,
  "startTime": "2026-08-14T20:00:00Z",
  "endTime": "2026-08-25T19:35:00Z",
  "memberId": "{{MemberId}}",
  "roomId": "{{RoomId}}"
}

### Update new Booking
PUT {{BaseUrl}}/{{BookingId}}
Content-Type: application/json
Authorization: Bearer {{Token}}

{
  "attendeeCount": 2,
  "startTime": "2026-08-11T20:14:00Z",
  "endTime": "2026-08-12T19:35:00Z",
  "roomId": "{{RoomId}}"
}

### Delete Member
DELETE {{BaseUrl}}/{{BookingId}}
Authorization: Bearer {{Token}}