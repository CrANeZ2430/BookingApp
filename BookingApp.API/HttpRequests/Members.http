@BaseUrl = {{Host}}/members
@MemberId = e1ffe403-dfe2-44b0-88ad-ff4d94001251

### Get all Members
GET {{BaseUrl}}
Accept: application/json
Authorization: Bearer {{Token}}

### Get Member by Id
GET {{BaseUrl}}/{{MemberId}}
Accept: application/json
Authorization: Bearer {{Token}}

### Post new Member
POST {{BaseUrl}}
Content-Type: application/json
Authorization: Bearer {{Token}}

{
  "auth0Id": "auth0id-123",
  "firstName": "Dean",
  "lastName": "Winchester",
  "role": "Customer",
  "email": "d.winchester@gmail.com",
  "phoneNumber": "+11234567890"
}

### Update Member
PUT {{BaseUrl}}/{{MemberId}}
Content-Type: application/json
Authorization: Bearer {{Token}}

{
  "firstName": "Sam",
  "lastName": "Winchester",
  "role": "Staff",
  "email": "s.winchester@gmail.com",
  "phoneNumber": "+11234567890"
}

### Delete Member
DELETE {{BaseUrl}}/{{MemberId}}
Authorization: Bearer {{Token}}
